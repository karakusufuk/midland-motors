---
import Base from '../../layouts/Base.astro';
import data from '../../data/cars.json';
export function getStaticPaths() { return data.cars.map(c => ({ params: { slug: c.slug }, props: { c } })); }
const { c } = Astro.props;
const name = `${c.year} ${c.make} ${c.model} ${c.variant}`;
const origin = Astro.site ?? new URL('https://midlandmotors.example');
const ld = {
  '@context': 'https://schema.org', '@type': 'Vehicle', name,
  brand: { '@type': 'Brand', name: c.make }, model: c.model, vehicleModelDate: String(c.year),
  fuelType: c.fuel, vehicleTransmission: c.transmission, color: c.colour,
  mileageFromOdometer: { '@type': 'QuantitativeValue', value: c.km, unitCode: 'KMT' },
  image: c.photos.map(p => new URL('/' + p, origin).href),
  offers: { '@type': 'Offer', price: c.price, priceCurrency: 'EUR', availability: 'https://schema.org/InStock',
    seller: { '@type': 'AutoDealer', name: 'Midland Motors', address: 'Dublin Road, Athlone, Co. Westmeath' } },
};
---
<Base title={`${c.make} ${c.model} · Midland Motors`} description={`${name}, ${c.km.toLocaleString('en-IE')} km, €${c.price.toLocaleString('en-IE')}. Inspected in our own workshop in Athlone.`} ld={ld} preload={'/' + c.photos[0].replace('.webp','-960.webp')}>
  <div class="wrap" style="padding-top:110px;max-width:560px">
    <div class="gal-main"><img src={'/' + c.photos[0].replace('.webp','-960.webp')} alt={`${c.make} ${c.model}`} width="1280" height="960" fetchpriority="high" /></div>
    <h1 class="d" style="font-size:clamp(32px,5vw,48px);margin-top:20px">{c.make} {c.model}</h1>
    <p class="muted">{c.variant} · €{c.price.toLocaleString('en-IE')}</p>
  </div>
</Base>
