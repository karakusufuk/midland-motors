---
import { CASE_STUDY_URL } from '../config';
---
<div class="cm" id="cm" hidden>
  <div class="cm-scrim" data-cm-close></div>
  <div class="cm-card" role="dialog" aria-modal="true" aria-labelledby="cm-title" aria-describedby="cm-body">
    <h2 class="cm-title" id="cm-title" tabindex="-1">Concept site by Ufuk Karakuş</h2>
    <p class="cm-body" id="cm-body"></p>
    <div class="cm-actions">
      <a class="btn btn-wine" id="cm-link" href={CASE_STUDY_URL} target="_blank" rel="noopener">See how it works →</a>
      <button type="button" class="btn btn-line" id="cm-close" data-cm-close>Close</button>
    </div>
  </div>
</div>

<style is:global>
.cm{position:fixed;inset:0;z-index:120;display:flex;align-items:center;justify-content:center;padding:16px;visibility:hidden;pointer-events:none;transition:visibility 0s .3s}
.cm[hidden]{display:flex}
.cm.on{visibility:visible;pointer-events:auto;transition-delay:0s}
.cm-scrim{position:absolute;inset:0;background:rgba(14,16,18,.55);opacity:0;transition:opacity .3s}
.cm.on .cm-scrim{opacity:1}
.cm-card{position:relative;width:min(480px,100%);background:var(--bg);color:var(--ink);border-radius:32px;padding:36px 32px 32px;display:flex;flex-direction:column;gap:14px;opacity:0;transform:translateY(14px) scale(.98);transition:opacity .3s,transform .45s var(--ease-out)}
.cm.on .cm-card{opacity:1;transform:none}
.cm-title{font:600 28px/1.15 var(--body);margin:0;outline:0}
.cm-body{margin:0;font-size:17px;line-height:1.5;color:var(--ink2)}
.cm-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:14px}
@media (max-width:640px){
  .cm{align-items:flex-end;padding:0}
  .cm-card{width:100%;border-radius:32px 32px 0 0;padding:32px 24px calc(24px + env(safe-area-inset-bottom,0px));transform:translateY(100%);opacity:1}
  .cm-actions .btn{flex:1 1 100%}
}
</style>
